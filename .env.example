# Neon Database (PostgreSQL)
# Get your connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/agrihire?sslmode=require

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Resend Email (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Uploadthing (https://uploadthing.com)
UPLOADTHING_TOKEN=your-uploadthing-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
